# Copiez ce fichier en `.env` (ou lancez `make init`). Ne commitez JAMAIS .env.

# --- PostgreSQL ---
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=crypto

# --- Airflow ---
# Linux : mettez votre UID (commande `id -u`) pour que les fichiers écrits dans ./data vous appartiennent.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-to-a-long-random-string

# --- APIs ---
# Si Binance est bloqué dans votre pays (HTTP 451) :
# BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com
# Clé "demo" gratuite CoinGecko (optionnelle, augmente la fiabilité) : https://www.coingecko.com/en/api
COINGECKO_API_KEY=
